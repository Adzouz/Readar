# Copy to .env or .env.local at the repo root (both gitignored). Used by the worker and `pnpm db:push`. Never commit the real file.
# Supabase dashboard → Connect → Session pooler (or Direct) connection string, with the DB password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: YouTube Data API key, used when a channel feed fails.
YOUTUBE_API_KEY=
